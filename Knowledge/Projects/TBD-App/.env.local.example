# Local-first: leave both variables empty to run without Supabase (data is stored in
# this browser via localStorage only).
#
# Cloud sync: set both to your project values from Supabase (Settings > API).
# The URL must be valid http(s); the anon key should be your full public anon key.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
